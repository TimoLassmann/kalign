# Writes a deterministic FASTA file of NSEQ short sequences (about LEN residues)
# that fall into a few families with point mutations and small indels, so the
# guide tree has structure.  More than 1,200 sequences uses the k-means guide
# tree.  Arguments: OUTFILE, NSEQ, LEN, ALPHABET (protein|dna).
if(NOT DEFINED LEN)
  set(LEN 40)
endif()
if(ALPHABET STREQUAL "dna")
  set(letters "ACGT")
else()
  set(letters "ACDEFGHIKLMNPQRSTVWY")
endif()
string(LENGTH "${letters}" nl)
set(state 12345)
# linear congruential generator, 31 bit
macro(next_rand)
  math(EXPR state "(${state} * 1103515245 + 12345) % 2147483648")
  math(EXPR rnd "${state} / 65536")
endmacro()

set(nfam 12)
set(fam_seq_list "")
foreach(f RANGE 1 ${nfam})
  set(s "")
  foreach(k RANGE 1 ${LEN})
    next_rand()
    math(EXPR idx "${rnd} % ${nl}")
    string(SUBSTRING "${letters}" ${idx} 1 c)
    string(APPEND s "${c}")
  endforeach()
  list(APPEND fam_seq_list "${s}")
endforeach()

set(content "")
math(EXPR last "${NSEQ} - 1")
foreach(i RANGE 0 ${last})
  next_rand()
  math(EXPR f "${rnd} % ${nfam}")
  list(GET fam_seq_list ${f} s)
  # a few point mutations
  foreach(m RANGE 1 4)
    next_rand()
    math(EXPR pos "${rnd} % ${LEN}")
    next_rand()
    math(EXPR idx "${rnd} % ${nl}")
    string(SUBSTRING "${letters}" ${idx} 1 c)
    math(EXPR after "${pos} + 1")
    string(SUBSTRING "${s}" 0 ${pos} left)
    string(SUBSTRING "${s}" ${after} -1 right)
    set(s "${left}${c}${right}")
  endforeach()
  # sometimes delete a stretch of up to 3 residues, sometimes trim the end
  next_rand()
  math(EXPR r "${rnd} % 4")
  if(r EQUAL 0)
    next_rand()
    math(EXPR pos "${rnd} % (${LEN} - 6)")
    math(EXPR after "${pos} + 1 + ${rnd} % 3")
    string(SUBSTRING "${s}" 0 ${pos} left)
    string(SUBSTRING "${s}" ${after} -1 right)
    set(s "${left}${right}")
  elseif(r EQUAL 1)
    next_rand()
    math(EXPR keep "${LEN} - ${rnd} % 5")
    string(SUBSTRING "${s}" 0 ${keep} s)
  endif()
  string(APPEND content ">q${i}\n${s}\n")
endforeach()
file(WRITE "${OUTFILE}" "${content}")
